rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isCreator() {
      return isVerifiedEmail() && (
        request.auth.token.email == 'ba.aldeen@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isCreatorOwner(data) {
      return isCreator() && data.ownerId == request.auth.uid;
    }

    // --- Validation Blueprint ---
    function isValidGift(data) {
      return data.keys().hasAll([
        'id', 'ownerId', 'title', 'recipientName', 'closingMessage', 'senderName',
        'originalName', 'mimeType', 'size', 'sourceType', 'videoUrl',
        'allowDownload', 'isPrimary', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerId', 'title', 'recipientName', 'closingMessage', 'senderName',
        'originalName', 'mimeType', 'size', 'sourceType', 'videoUrl',
        'allowDownload', 'isPrimary', 'status', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
      && data.recipientName is string && data.recipientName.size() <= 80
      && data.closingMessage is string && data.closingMessage.size() >= 1 && data.closingMessage.size() <= 140
      && data.senderName is string && data.senderName.size() <= 80
      && data.originalName is string && data.originalName.size() >= 1 && data.originalName.size() <= 200
      && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 64
      && data.size is int && data.size >= 0 && data.size <= 2147483648
      && data.sourceType in ['server', 'url']
      && data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500
      && data.allowDownload is bool
      && data.isPrimary is bool
      && data.status in ['uploading', 'ready']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Connection health check endpoint (read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Lightweight gifts metadata collection
    match /gifts/{giftId} {
      allow get: if isValidId(giftId) && (
        resource.data.status == 'ready' ||
        isCreatorOwner(resource.data)
      );

      allow list: if (
        isVerifiedEmail() && (
          request.auth.token.email == 'ba.aldeen@gmail.com' ||
          resource.data.ownerId == request.auth.uid
        )
      ) || (
        resource.data.status == 'ready' && resource.data.isPrimary == true
      );

      allow create: if isCreator()
        && isValidId(giftId)
        && isValidGift(incoming())
        && incoming().id == giftId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isCreatorOwner(existing())
        && isValidId(giftId)
        && isValidGift(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Finalize publication
          (existing().status == 'uploading' && incoming().status == 'ready' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          // Action 2: Edit presentation copy & download permission
          (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'recipientName', 'closingMessage', 'senderName', 'allowDownload', 'updatedAt'])) ||
          // Action 3: Set or unset primary gift
          (incoming().diff(existing()).affectedKeys().hasOnly(['isPrimary', 'updatedAt']))
        );

      allow delete: if isValidId(giftId) && isCreatorOwner(existing());
    }
  }
}
